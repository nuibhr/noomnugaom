# Comma-separated origins. Use a specific frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CACHE_TTL_SECONDS=300
APP_ENV=development

# Set these before public deployment. With APP_ENV=production, ACTION_API_KEY is mandatory.
# PUBLIC_BASE_URL=https://api.example.com
# ACTION_API_KEY=replace-with-a-new-random-secret

# Required only to use the official US SEC EDGAR provider.
# SEC_USER_AGENT=Noomnugaom/1.0 contact@example.com
